{
  "name": "babalon-js",
  "private": true,
  "version": "1.0.1",
  "description": "A simple, touch-friendly 3D scene composer built on Babylon.js: place models, light them and take photos.",
  "license": "GPL-3.0-or-later",
  "author": "Guilherme Holanda Sanches",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug && cd ..",
    "android:bundle": "npm run build && npx cap sync android && cd android && .\\gradlew.bat bundleRelease && cd ..",
    "android:assets": "npx @capacitor/assets generate --android --iconBackgroundColor \"#120d1b\" --splashBackgroundColor \"#120d1b\"",
    "android:prepare-distribution": "node scripts/prepare-android-distribution.mjs",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.6.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@babylonjs/materials": "^9.30.0",
    "@babylonjs/serializers": "^9.30.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "ktx-parse": "^1.1.0",
    "ktx2-encoder": "^0.6.0",
    "lucide": "^1.54.0",
    "manifold-3d": "^3.5.4",
    "meshoptimizer": "^1.3.0"
  }
}
