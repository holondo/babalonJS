<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer gold ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="#E9A83B" />
            <solid android:color="#00000000" />
            <size
                android:width="72dp"
                android:height="72dp" />
        </shape>
    </item>
    <!-- Inner white/gold circle -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#E9A83B" />
        </shape>
    </item>
</layer-list>
